# ═══════════════════════════════════════════════════════════════
#  MSU Scoring — .env.example
#  ตัวอย่างไฟล์ environment variables
#  (ไฟล์นี้ commit ได้ — ไม่มีข้อมูลจริง)
#
#  วิธีใช้: copy ไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ
#  คำสั่ง: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# URL ของแอปบน server (เปลี่ยนตาม environment)
APP_URL=https://score.msu.ac.th
APP_ENV=production

# Google OAuth Client ID
# รับค่านี้จาก https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# ตั้งค่า session (หน่วยเป็นวินาที)
SESSION_LIFETIME=7200

# MySQL Database Connection
# สำหรับพัฒนา (XAMPP): DB_HOST=127.0.0.1, DB_USER=root, DB_PASS=
# สำหรับ Docker:        DB_HOST=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=msuscore
DB_USER=root
DB_PASS=your_password_here
